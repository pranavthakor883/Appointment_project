# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder — do not put real credentials in this file.

# --- Application ---
APP_NAME=Appointment Booking API
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=appointment_booking
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
# Assembled in app/config.py from the values above; override only if needed.
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/appointment_booking

# Separate database used by pytest. Never point this at the dev database —
# the test suite truncates it.
TEST_POSTGRES_DB=appointment_booking_test

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_a_random_secret_do_not_use_this_value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins. Never use "*" in production.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Booking rules ---
DEFAULT_TIMEZONE=UTC
DEFAULT_SLOT_MINUTES=30
MIN_BOOKING_NOTICE_MINUTES=60
MAX_BOOKING_DAYS_AHEAD=90
CANCELLATION_WINDOW_HOURS=24

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Future: Redis / background jobs (not used yet) ---
# REDIS_URL=redis://localhost:6379/0

# --- Future: email notifications (not used yet) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=

# --- Future: payments (not used yet) ---
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

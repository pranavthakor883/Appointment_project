# Copy to .env and fill in real values. NEVER commit .env.
# Every value below is a placeholder — do not put real credentials in this file.

# --- Application ---
APP_NAME=Appointment Booking API
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production
API_V1_PREFIX=/api/v1

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_booking
DB_USER=change_me
DB_PASSWORD=change_me

# Separate database used by pytest. Never point this at the dev database —
# the test suite truncates it.
TEST_POSTGRES_DB=appointment_booking_test

# --- Security / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY has no default in app/config.py — the app refuses to start
# without it, so that tokens are never signed with a value from source control.
JWT_SECRET_KEY=generate_a_random_secret_do_not_use_this_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed origins. Never use "*" in production.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Booking rules ---
DEFAULT_TIMEZONE=UTC
DEFAULT_SLOT_MINUTES=30
MIN_BOOKING_NOTICE_MINUTES=60
MAX_BOOKING_DAYS_AHEAD=90
CANCELLATION_WINDOW_HOURS=24

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Future: Redis / background jobs (not used yet) ---
# REDIS_URL=redis://localhost:6379/0

# --- Future: email notifications (not used yet) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=

# --- Future: payments (not used yet) ---
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
